[Unit]
Description=Davijara.uz — Next.js production server
After=network.target

[Service]
Type=simple
User=davijara
Group=davijara

# `current` is a symlink deploy.sh points at the newest release — see
# deploy/deploy.sh. Restarting this unit after the symlink flips is what
# actually cuts over to a new build.
WorkingDirectory=/var/www/davijara/current

# Server-only secrets (LISTINGS_API_URL, API_USER, API_PASSWORD). Lives
# outside any release directory so redeploys can never touch or overwrite it.
# Create once by hand on the server: chmod 600, owned by the davijara user.
EnvironmentFile=/var/www/davijara/shared/.env

Environment=NODE_ENV=production
# 3001, not the default 3000 — the `markaz` server already runs a separate
# Auth.js-based app on 127.0.0.1:3000 (confirmed: curl there returns that
# app's own login redirect, not ours). 3001 is the port the existing
# `location /site` block in nginx already forwards to.
Environment=PORT=3001
# Loopback only — nginx is the one thing allowed to reach this port; see
# deploy/nginx-site-location.conf. Never exposed directly to the internet.
Environment=HOSTNAME=127.0.0.1

# `output: "standalone"` in next.config.ts writes exactly this entry point.
ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=5

# Sandboxing. NoNewPrivileges + ProtectSystem=strict run the app read-only
# outside its own tree; the one thing it writes is its ISR/data cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# Leading "-" means "skip if missing" instead of refusing to start.
#
# Without it the service died at boot with status=226/NAMESPACE: with
# ProtectSystem=strict, systemd sets up a mount namespace and bind-mounts
# each ReadWritePaths entry, and a path that does not exist yet is a hard
# failure of that setup — not a warning. Next only creates .next/cache the
# first time it writes to it, so on a brand-new release the directory is
# genuinely absent and the unit could never reach its first start.
#
# deploy.sh now also mkdir's this per release, so the "-" is the belt to that
# braces: it keeps a missing cache dir from being fatal no matter how the
# release was assembled.
ReadWritePaths=-/var/www/davijara/current/.next/cache

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
