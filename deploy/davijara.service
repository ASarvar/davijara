[Unit]
Description=Davijara.uz — Next.js production server
After=network.target

# Give up after 5 failed starts in 5 minutes instead of retrying forever.
#
# Restart=on-failure with RestartSec=5 never trips systemd's default limit
# (5 starts per 10s), so a genuinely broken deploy just loops: this unit was
# observed at "restart counter is at 2367" against a WorkingDirectory that
# did not exist. A service that stops in `failed` state is far easier to
# notice than one perpetually "activating (auto-restart)", and it stops
# filling the journal with the same line.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=davijara
Group=davijara

# `current` is a symlink deploy.sh points at the newest release — see
# deploy/deploy.sh. Restarting this unit after the symlink flips is what
# actually cuts over to a new build.
WorkingDirectory=/var/www/davijara/current

# Server-only secrets (LISTINGS_API_URL, API_USER, API_PASSWORD). Lives
# outside any release directory so redeploys can never touch or overwrite it.
# Create once by hand on the server: chmod 600, owned by the davijara user.
EnvironmentFile=/var/www/davijara/shared/.env

Environment=NODE_ENV=production
# 3001, not the default 3000 — the `markaz` server already runs a separate
# Auth.js-based app on 127.0.0.1:3000 (confirmed: curl there returns that
# app's own login redirect, not ours). 3001 is the port the existing
# `location /site` block in nginx already forwards to.
Environment=PORT=3001
# Loopback only — nginx is the one thing allowed to reach this port; see
# deploy/nginx-site-location.conf. Never exposed directly to the internet.
#
# "localhost", NOT "127.0.0.1", and that distinction is load-bearing.
#
# Next builds the origin it validates middleware rewrites against from THIS
# value, not from the Host header:
#     initUrl = `${protocol}://${formatHostname(opts.hostname || 'localhost')}:${port}`
#         — next/dist/server/lib/router-utils/resolve-routes.js
# It then compares that origin to the rewrite next-intl emits, which is built
# on next-intl's own default of `localhost`. With HOSTNAME=127.0.0.1 the two
# disagree, Next classifies its OWN rewrite as an external destination, and
# proxies the request to itself — every page 500'd with
# "Failed to proxy … socket hang up". Reproduced against a production build
# under both `Host: 127.0.0.1:<port>` and `Host: davijara.uz`, so nginx would
# not have masked it. Matching the two names makes the rewrite resolve as
# relative and route internally.
#
# Still loopback either way. On THIS box Node resolves `localhost` to ::1, so
# the listener is IPv6 loopback only — which is why the nginx block proxies to
# [::1]:3001 rather than 127.0.0.1. Changing this value means re-checking
# `ss -ltnp | grep 3001` and matching deploy/nginx-site-location.conf to it.
Environment=HOSTNAME=localhost

# `output: "standalone"` in next.config.ts writes exactly this entry point.
ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=5

# Sandboxing. NoNewPrivileges + ProtectSystem=strict run the app read-only
# outside its own tree; the one thing it writes is its ISR/data cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# Leading "-" means "skip if missing" instead of refusing to start.
#
# Without it the service died at boot with status=226/NAMESPACE: with
# ProtectSystem=strict, systemd sets up a mount namespace and bind-mounts
# each ReadWritePaths entry, and a path that does not exist yet is a hard
# failure of that setup — not a warning. Next only creates .next/cache the
# first time it writes to it, so on a brand-new release the directory is
# genuinely absent and the unit could never reach its first start.
#
# deploy.sh now also mkdir's this per release, so the "-" is the belt to that
# braces: it keeps a missing cache dir from being fatal no matter how the
# release was assembled.
ReadWritePaths=-/var/www/davijara/current/.next/cache

# The admin panel's SQLite database and the files editors upload.
#
# NO leading "-" here, deliberately, and it is the opposite call to the line
# above. That one may legitimately be missing on a fresh release; this one may
# not. If DATA_DIR is absent the panel cannot store a single news item, and
# the failure would surface as SQLITE_CANTOPEN on whichever page an editor
# happened to open — long after the deploy looked successful. Refusing to
# start is the louder and more honest failure.
#
# It is OUTSIDE current/ on purpose: deploy.sh keeps only the last five
# releases, so a database inside a release directory is deleted five deploys
# later, silently. See lib/db/index.ts and the DEPLOY.md admin section.
#
# ⚠ Must match DATA_DIR in shared/.env. Changing either alone breaks the panel.
ReadWritePaths=/var/www/davijara/shared/data

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
